# Supabase (local development - run `pnpm supabase start` to get actual values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Supabase CLI (local)
SUPABASE_ACCESS_TOKEN=

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Production (configure in Vercel dashboard / Supabase dashboard)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_production_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key (server-side only, NEVER in client bundle)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# AUTH_REDIRECT_URL=https://your-domain.vercel.app/auth/callback