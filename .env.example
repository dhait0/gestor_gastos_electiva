# Base de datos: en Vercel usa PostgreSQL (Supabase/Neon).
# SQLite NO funciona en Vercel (el filesystem es efímero).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secreto para firmar las sesiones de Auth.js (OBLIGATORIO en producción)
AUTH_SECRET=""

# Credenciales de Google OAuth (obtener en Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Usuario administrador sembrado en el primer arranque de la app
ADMIN_EMAIL="admin@finwise.dev"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
